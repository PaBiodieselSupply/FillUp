<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent" >

    <!--
        DATA ENTRY MODE: the user enters COST and GALLONS, and PRICE is calculated.

        NOTE: the form fields below are laid out with a vertical LinearLayout, not
        a RelativeLayout. The fuel type selector hides the price and cost blocks
        when Black Diesel is chosen, and setting a view GONE inside a RelativeLayout
        collapses it to position (0,0) - which sends every view anchored to it to
        the top of the screen. A LinearLayout handles GONE correctly for free.
    -->

    <!-- BAR WITH OK/CANCEL BUTTONS ACCROSS BOTTOM -->
    <RelativeLayout
        android:id="@+id/buttonBar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/dialog_buttonbar_bg"
        android:gravity="right"
        android:padding="4dip" >

        <ImageButton
            android:id="@+id/buttonMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:contentDescription="@string/mode_description"
            android:onClick="clickedMode"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:src="@drawable/ic_btn_mode" />

        <Button
            android:id="@+id/buttonCancel"
            android:layout_width="100dip"
            android:layout_height="wrap_content"
			android:layout_alignParentRight="true"
            android:onClick="clickedCancel"
            android:text="@string/cancel_label" />

        <Button
            android:id="@+id/buttonOK"
            android:layout_width="100dip"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@id/buttonCancel"
            android:onClick="clickedOk"
            android:text="@string/ok_label" />
    </RelativeLayout>

    <!-- SCROLL VIEW CONTAINING ALL FORM FIELDS -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:layout_alignParentTop="true"
        android:layout_above="@id/buttonBar" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dip" >

            <!-- FUEL TYPE (required, selected before anything else) -->
            <TextView
                android:id="@+id/textViewFuelType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fuel_type_label" />

            <RadioGroup
                android:id="@+id/radioGroupFuelType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" >

                <RadioButton
                    android:id="@+id/radioFuelTypeDiesel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/fuel_type_diesel" />

                <RadioButton
                    android:id="@+id/radioFuelTypeWvo"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/fuel_type_wvo" />
            </RadioGroup>

            <TextView
                android:id="@+id/textViewDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/date_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" >

                <EditText
                    android:id="@+id/editTextDate"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:clickable="false"
                    android:inputType="datetime" />

                <ImageButton
                    android:id="@+id/buttonEditDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:onClick="clickedEditDate"
                    android:contentDescription="@string/edit_description"
                    android:src="@drawable/ic_btn_edit" />
            </LinearLayout>

            <TextView
                android:id="@+id/textViewOdometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/odometer_units_label" />

            <EditText
                android:id="@+id/editTextOdometer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="number"
                android:hint="@string/hint_odometer"
                android:imeOptions="actionNext" >
                <requestFocus />
            </EditText>

            <!-- COST (hidden for Black Diesel, which has no purchase cost) -->
            <LinearLayout
                android:id="@+id/groupCost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" >

                <TextView
                    android:id="@+id/textViewCost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_cost_label" />

                <EditText
                    android:id="@+id/editTextCost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_cost"
                    android:digits="0123456789.,"
                    android:ems="10"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal" />
            </LinearLayout>

			<TextView
                android:id="@+id/textViewGallons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gasoline_label" />

            <EditText
                android:id="@+id/editTextGallons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789.,"
                android:ems="10"
                android:inputType="numberDecimal"
                android:hint="@string/hint_gasoline"
                android:imeOptions="actionNext" />

            <!-- PRICE (calculated in this mode; hidden for Black Diesel) -->
            <LinearLayout
                android:id="@+id/groupPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" >

                <TextView
                    android:id="@+id/textViewPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/price_label" />

                <EditText
                    android:id="@+id/editTextPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="0123456789.,"
                    android:ems="10"
                    android:inputType="numberDecimal"
                    android:hint="@string/hint_price"
                    android:enabled="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:clickable="false"
                    android:longClickable="false"
                    android:textColor="@color/calc_text_color"
                    android:textColorHint="@color/calc_hint_color" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/checkBoxFullTank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/full_tank_label" />

            <TextView
                android:id="@+id/textViewNotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notes_label" />

            <EditText
                android:id="@+id/editTextNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_notes"
                android:inputType="text|textShortMessage|textAutoCorrect|textCapSentences|textMultiLine"
                android:maxLength="80"
                android:lines="3"
                android:maxLines="3"
                android:minLines="3"
                android:imeOptions="flagNoEnterAction|actionDone"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
