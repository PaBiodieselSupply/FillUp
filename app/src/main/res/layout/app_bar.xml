<?xml version="1.0" encoding="utf-8"?>

<!--
    App bar for the home screen: app icon and title on the left, overflow on the right.

    Sized to match the original FillUp's action bar exactly, measured from a
    screenshot of it on a Pixel 7: 48dp tall, solid #333333, no divider, a 32dp
    icon 12dp from the left, an 18dp title and a 48dp overflow button. The title
    size is in dp rather than sp on purpose - the original's title ignores the
    system font size setting too.

    This is a plain layout rather than a real ActionBar because the app theme is
    deliberately left as Theme.Black.NoTitleBar - switching to a theme with an
    ActionBar would restyle every screen in the app.

    It exists because raising targetSdk above 10 removed the virtual menu key
    that Android used to supply in the navigation bar. Without it there is no way
    to open an options menu at all. The overflow button opens the same menu via a
    PopupMenu - see MainActivity.showOverflowMenu().
-->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@color/app_bar_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingRight="4dp" >

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="12dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_launcher" />

    <TextView
        android:id="@+id/textViewAppBarTitle"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="@string/app_name"
        android:textColor="@color/app_bar_fg"
        android:textSize="18dp" />

    <ImageButton
        android:id="@+id/buttonAppBarMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/menu_description"
        android:scaleType="center"
        android:src="@drawable/ic_overflow" />

</LinearLayout>
