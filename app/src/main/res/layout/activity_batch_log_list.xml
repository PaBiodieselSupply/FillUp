<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/log_bg"
    android:orientation="vertical" >

    <!--
        The centrifuge batch log deliberately mirrors activity_gas_log_list.xml
        exactly - same spiral header, same header row styling, same list styling -
        so the two logs read as the same kind of screen.
    -->

    <!-- SPIRAL NOTE BOOK HEADER -->
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/spiral_header"
        android:gravity="left"
        android:orientation="horizontal" />

    <!-- HEADER ROW -->
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/log_header_bg"
        android:gravity="left"
        android:orientation="horizontal"
        android:padding="4dip" >

        <TextView
            android:id="@+id/headerBatchDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.35"
            android:gravity="left"
            android:text="@string/date_label"
            android:textColor="@color/log_header_fg"
            android:textSize="@dimen/log_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/headerBatchYield"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.40"
            android:gravity="right"
            android:text="@string/gallons_label"
            android:textColor="@color/log_header_fg"
            android:textSize="@dimen/log_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/headerBatchPercent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.25"
            android:gravity="right"
            android:text="@string/batch_yield_percent_label"
            android:textColor="@color/log_header_fg"
            android:textSize="@dimen/log_text_size"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- LIST OF BATCH RECORDS -->
    <ListView
        android:id="@+id/batch_log_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/log_bg"
        android:cacheColorHint="@color/log_bg"
        android:divider="@color/log_divider_color"
        android:dividerHeight="1dip"
        android:padding="4dip" />

</LinearLayout>
