    <!--
        FUEL TYPE

        "Waste Oil Fuel" covers both WVO (vegetable) and WMO (motor) oil feedstock,
        which is why it is not called "Black Diesel" anywhere the customer can see.

        NOTE: the value persisted to the database and to CSV is still the token
        "wvo" - see FuelType. That token is an internal identifier, never displayed,
        and changing it would require a data migration and would break every CSV
        already exported.
    -->
    <string name="fuel_type_label">Fuel Type</string>
    <string name="fuel_type_diesel">Pump Diesel</string>
